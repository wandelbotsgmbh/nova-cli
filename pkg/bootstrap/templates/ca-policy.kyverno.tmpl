# Generated by nova bootstrap
---
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: proxy-ca-injection
  annotations:
    policies.kyverno.io/title: Inject Proxy CA Bundle
    policies.kyverno.io/description: >-
      Injects the proxy CA into the system trust store of Pods in namespace
      [[ .Namespace ]] so libraries that verify against
      /etc/ssl/certs/ca-certificates.crt (Cryptlex LexActivator, Go net/http)
      accept a TLS-inspecting proxy.
[[- define "caMatch" ]]
      match:
        any:
          - resources:
              kinds:
                - Pod
              namespaces:
                - [[ .Namespace ]]
[[- if .AppNames ]]
              selector:
                matchExpressions:
                  - key: app.kubernetes.io/name
                    operator: In
                    values:
[[- range .AppNames ]]
                      - [[ . ]]
[[- end ]]
[[- end ]]
[[- end ]]
spec:
  background: false
  rules:
    - name: add-proxy-ca-volumes-and-init
[[ template "caMatch" . ]]
      mutate:
        patchStrategicMerge:
          spec:
            volumes:
              - name: proxy-ca-bundle
                emptyDir: {}
              - name: proxy-ca-source
                configMap:
                  name: [[ .ConfigMapName ]]
            initContainers:
              - name: proxy-ca-merge
                image: [[ .InitImage ]]
                command:
                  - /bin/sh
                  - -c
                  - |
                    set -e
                    cp /etc/ssl/certs/ca-certificates.crt /merged/ca-certificates.crt
                    printf '\n' >> /merged/ca-certificates.crt
                    cat /proxy-ca/[[ .ConfigMapKey ]] >> /merged/ca-certificates.crt
                securityContext:
                  allowPrivilegeEscalation: false
                  runAsNonRoot: true
                  runAsUser: 65532
                  runAsGroup: 65532
                  readOnlyRootFilesystem: true
                  capabilities:
                    drop:
                      - ALL
                volumeMounts:
                  - name: proxy-ca-bundle
                    mountPath: /merged
                  - name: proxy-ca-source
                    mountPath: /proxy-ca
                    readOnly: true
    - name: mount-proxy-ca-into-containers
[[ template "caMatch" . ]]
      mutate:
        foreach:
          - list: "request.object.spec.containers"
            patchStrategicMerge:
              spec:
                containers:
                  - name: "{{ element.name }}"
                    volumeMounts:
                      - name: proxy-ca-bundle
                        mountPath: /etc/ssl/certs/ca-certificates.crt
                        subPath: ca-certificates.crt
                        readOnly: true
                    env:
                      - name: SSL_CERT_FILE
                        value: /etc/ssl/certs/ca-certificates.crt

# Generated by nova bootstrap
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: service-manager
  namespace: kube-system
spec:
  chart: oci://{{ .OCIRegistry }}/{{ .OCIChart }}
  version: {{ .ChartVersion }}
  targetNamespace: {{ .Namespace }}
  createNamespace: true
  backOffLimit: 50
{{- if .InsecureSkipTLSVerify }}
  insecureSkipTLSVerify: true
{{- else if .RepoCAConfigMap }}
  repoCAConfigMap:
    name: {{ .RepoCAConfigMap }}
{{- end }}
  dockerRegistrySecret:
    name: {{ .PullSecretName }}
  valuesContent: |-
    hooks:
      defaultCell:
        enabled: true
{{- if or .HTTPProxy .HTTPSProxy .NoProxy }}
    global:
      proxy:
{{- if .HTTPProxy }}
        httpProxy: "{{ .HTTPProxy }}"
{{- end }}
{{- if .HTTPSProxy }}
        httpsProxy: "{{ .HTTPSProxy }}"
{{- end }}
{{- if .NoProxy }}
        noProxy: "{{ .NoProxy }}"
{{- end }}
{{- end }}

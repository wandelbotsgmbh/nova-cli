# Generated by nova bootstrap
---
apiVersion: v1
kind: Pod
metadata:
  name: {{ .Name }}
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/name: nova-k3s-env-reader
    app.kubernetes.io/managed-by: nova-cli
spec:
  restartPolicy: Never
  hostNetwork: true
  tolerations:
  - operator: Exists
  containers:
  - name: reader
    image: wandelbots.azurecr.io/docker.io/library/alpine:3
    command: ["cat", "/host/k3s.service.env"]
    volumeMounts:
    - name: k3s-env
      mountPath: /host/k3s.service.env
      readOnly: true
{{- if .PullSecretNames }}
  imagePullSecrets:
{{- range .PullSecretNames }}
  - name: {{ . }}
{{- end }}
{{- end }}
  volumes:
  - name: k3s-env
    hostPath:
      path: {{ .Path }}
      type: File

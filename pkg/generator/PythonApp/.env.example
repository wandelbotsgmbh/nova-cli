# provide the host where the nova api is running (e.g. your virtual dev instance)
NOVA_API=
CELL_NAME="cell"
LOG_LEVEL=info

###
# SECRETS
#
# These should never be committed. Keep them in the gitignored .env only (`nova app update-env`
# writes a fresh NOVA_ACCESS_TOKEN there) or in the environment variables of the deployment.
###
NOVA_ACCESS_TOKEN=""

{
    // Debugging requires the CodeLLDB extension (vadimcn.vscode-lldb).
    // The app reads its settings from .env.local, run `nova app env` to create or refresh it.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=app"]
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}

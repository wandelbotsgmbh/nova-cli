                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "offset",
            "description": "Items to skip; default 0.",
            "schema": {
              "description": "Items to skip; default 0.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list envelope; `nextLink` only present when more items remain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection_for_ApplicationInfo"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
